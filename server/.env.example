# Which LLM to use: "gemini" (has a free tier) or "anthropic"
LLM_PROVIDER=gemini

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# One model or a comma-separated fallback list: if a model is busy (503/429/timeout),
# the next one is tried.
# GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Comma-separated list of frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173

# Max questions per client IP per minute
ASK_RATE_LIMIT=10
